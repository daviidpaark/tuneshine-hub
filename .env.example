TUNESHINE_HOST=192.168.1.112
PORT=8585
CLEAR_DELAY=2.0

# Spotify Web API Configuration (Optional)
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=your_client_id_here
